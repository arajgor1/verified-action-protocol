{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vap.invalid/0.1/operation.schema.json",
  "title": "Operation",
  "description": "A durably accepted execution of one plan. execution_status, verification_status and recovery_status are independent dimensions. outcome is derived from them for display and never replaces them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "id", "plan_id", "task_id", "action_id", "principal", "request_key_digest", "execution_status", "verification_status", "recovery_status", "outcome", "result_summary", "effects", "attempts", "external_handle", "cancel_requested", "recovers_operation_id", "recovery_operation_ids", "unresolved", "error", "created_at", "updated_at", "submitted_at", "completed_at", "row_revision"],
  "properties": {
    "protocol_version": { "$ref": "common.schema.json#/$defs/protocol_version" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "plan_id": { "$ref": "common.schema.json#/$defs/id" },
    "task_id": { "$ref": "common.schema.json#/$defs/id" },
    "action_id": { "$ref": "common.schema.json#/$defs/action_id" },
    "principal": { "$ref": "common.schema.json#/$defs/principal" },
    "request_key_digest": { "type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$", "description": "Keyed digest. The raw request key is never stored." },
    "execution_status": { "$ref": "common.schema.json#/$defs/execution_status" },
    "verification_status": { "$ref": "common.schema.json#/$defs/verification_status" },
    "recovery_status": { "$ref": "common.schema.json#/$defs/recovery_status" },
    "outcome": { "$ref": "common.schema.json#/$defs/outcome" },
    "result_summary": { "type": ["object", "null"] },
    "effects": { "type": "array", "maxItems": 1000, "items": { "$ref": "common.schema.json#/$defs/effect" } },
    "attempts": { "type": "integer", "minimum": 0 },
    "external_handle": { "type": ["string", "null"], "maxLength": 512 },
    "cancel_requested": { "type": "boolean" },
    "recovers_operation_id": { "anyOf": [{ "$ref": "common.schema.json#/$defs/id" }, { "type": "null" }] },
    "recovery_operation_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } },
    "unresolved": { "type": "boolean", "description": "True while the operation could still have effects VAP has not established (queued, running, unknown)." },
    "error": { "anyOf": [{ "$ref": "common.schema.json#/$defs/error" }, { "type": "null" }] },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "updated_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "submitted_at": { "$ref": "common.schema.json#/$defs/nullable_timestamp" },
    "completed_at": { "$ref": "common.schema.json#/$defs/nullable_timestamp" },
    "row_revision": { "type": "integer", "minimum": 1 },
    "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
  }
}
