{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vap.invalid/0.1/grant.schema.json",
  "title": "Grant",
  "description": "Operator-issued authority for one principal. Agents and application content can never create or elevate a grant.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "id", "principal", "allowed_actions", "allowed_targets", "risk_ceiling", "preauthorized_actions", "limits", "expires_at", "revocation_revision", "revoked_at", "issuer", "created_at"],
  "properties": {
    "protocol_version": { "$ref": "common.schema.json#/$defs/protocol_version" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "principal": { "$ref": "common.schema.json#/$defs/principal" },
    "allowed_actions": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "common.schema.json#/$defs/action_pattern" } },
    "allowed_targets": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "common.schema.json#/$defs/resource_pattern" } },
    "risk_ceiling": { "$ref": "common.schema.json#/$defs/risk_tier" },
    "preauthorized_actions": {
      "description": "Tier-2 actions that may run without plan-bound approval under this grant. Tier 3 always requires human approval.",
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "common.schema.json#/$defs/action_pattern" }
    },
    "limits": { "$ref": "#/$defs/limits" },
    "expires_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "revocation_revision": { "type": "integer", "minimum": 0 },
    "revoked_at": { "$ref": "common.schema.json#/$defs/nullable_timestamp" },
    "issuer": { "$ref": "common.schema.json#/$defs/principal" },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
  },
  "$defs": {
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_operations", "max_items_per_operation", "max_concurrent_operations"],
      "properties": {
        "max_operations": { "type": ["integer", "null"], "minimum": 1 },
        "max_items_per_operation": { "type": ["integer", "null"], "minimum": 1 },
        "max_concurrent_operations": { "type": ["integer", "null"], "minimum": 1 }
      }
    }
  }
}
