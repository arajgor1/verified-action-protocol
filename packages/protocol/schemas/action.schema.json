{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vap.invalid/0.1/action.schema.json",
  "title": "Action descriptor",
  "description": "A registered operation an adapter can perform. Capabilities are per action, machine-readable and orthogonal; there is no linear maturity score.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "id", "title", "adapter", "input_schema", "effect_scope", "preconditions", "side_effects", "risk_tier", "capabilities", "verifier_ids", "recovery_modes", "plan_ttl_seconds"],
  "properties": {
    "protocol_version": { "$ref": "common.schema.json#/$defs/protocol_version" },
    "id": { "$ref": "common.schema.json#/$defs/action_id" },
    "title": { "type": "string", "maxLength": 200 },
    "description": { "type": "string", "maxLength": 2000 },
    "adapter": { "$ref": "#/$defs/adapter_ref" },
    "input_schema": { "type": "object", "description": "JSON Schema (2020-12) for the action's arguments." },
    "effect_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_template", "description"],
      "properties": {
        "resource_template": { "type": "string", "maxLength": 2048 },
        "description": { "$ref": "common.schema.json#/$defs/short_text" }
      }
    },
    "preconditions": { "type": "array", "maxItems": 32, "items": { "$ref": "common.schema.json#/$defs/short_text" } },
    "side_effects": { "type": "array", "maxItems": 32, "items": { "$ref": "common.schema.json#/$defs/side_effect" } },
    "risk_tier": { "$ref": "common.schema.json#/$defs/risk_tier" },
    "capabilities": { "$ref": "common.schema.json#/$defs/capability_vector" },
    "verifier_ids": { "type": "array", "maxItems": 16, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$" } },
    "recovery_modes": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mode", "action_id", "description"],
        "properties": {
          "mode": { "$ref": "common.schema.json#/$defs/recovery_mode" },
          "action_id": { "anyOf": [{ "$ref": "common.schema.json#/$defs/action_id" }, { "type": "null" }] },
          "description": { "$ref": "common.schema.json#/$defs/short_text" }
        }
      }
    },
    "plan_ttl_seconds": { "type": "integer", "minimum": 10, "maximum": 86400 },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "max_items": { "type": ["integer", "null"], "minimum": 1 } }
    },
    "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
  },
  "$defs": {
    "adapter_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$" },
        "version": { "type": "string", "maxLength": 64 }
      }
    }
  }
}
