# Non-secret runtime settings. Secrets (database URLs, VAP_DIGEST_KEY) are injected by the
# deployment's secret facility, never written to files in this repository.
VAP_ENV=production
VAP_AUTH_MODE=oidc
VAP_OIDC_AUDIENCE=https://<your-vap-api-url>
VAP_DEPLOYMENT_ID=staging
VAP_DISPATCH_MODE=cloud-run-job
VAP_WORKER_JOB=projects/<your-project-id>/locations/<your-region>/jobs/vap-worker-staging
VAP_ADAPTERS_CONFIG=/app/examples/config/adapters.fixture.json
VAP_LOG_LEVEL=info
