    family-names: Rajgor
    orcid: "https://orcid.org/0009-0006-3009-5559"
repository-code: "https://github.com/arajgor1/verified-action-protocol"
license: Apache-2.0
version: 0.1.0-rc.1
keywords:
  - ai-agents
  - tool-calling
  - model-context-protocol
  - verification
  - idempotency
  - reliability
